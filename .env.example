# 复制本文件为 .env 并填入你自己的值
# .env 已被 .gitignore 忽略，不会上传到仓库
# 部署前必须配置以下变量，否则函数会因取不到密钥而无法调用模型

# TokenHub 共享密钥（glm / kimi / deepseek 等模型的统一调用入口）
TOKENHUB_API_KEY=your_tokenhub_key_here

# 你的 DeepSeek 官方 Key（TokenHub 额度耗尽时自动兜底）
DEEPSEEK_API_KEY=your_deepseek_key_here

# 百度智能/联网搜索 Key（qianfan.baidubce.com，可选；不填则联网搜索走腾讯 WSA 兜底）
BAIDU_API_KEY=your_baidu_key_here

# 腾讯 WSA 联网搜索 Key（api.wsa.cloud.tencent.com，可选；不填则走百度兜底）
WSA_API_KEY=your_wsa_key_here

# CloudBase 环境 ID（在 CloudBase 控制台获取）
YOUR_CLOUDBASE_ENV_ID=your_env_id

# 前端调用的后端域名（部署后从 CloudBase 静态托管地址获得，形如 <envId>-<hash>.ap-shanghai.app.tcloudbase.com）
YOUR_CLOUDBASE_API_HOST=your-env-id-hash.ap-shanghai.app.tcloudbase.com
